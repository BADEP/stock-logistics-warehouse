<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="VlmTaskRequestListView.buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="." position="inside">
            <button
                t-if="this.hasSelectedRecords"
                class="btn btn-secondary"
                type="button"
                t-on-click="this.onClickVlmRequest"
            >
                <i
                class="fa fa-rocket"
                title="Perform tasks"
                role="image"
            /> Perform tasks
            </button>
        </xpath>
    </t>
</templates>
